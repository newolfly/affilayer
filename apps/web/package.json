{
  "dependencies": {
    "@affilayer/shared": "*",
    "@supabase/supabase-js": "^2.45.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "description": "AffiLayer web frontend \u2014 public site, auth, and role-based affiliate / advertiser / admin app",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^5.4.21"
  },
  "name": "@affilayer/web",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "postbuild": "node ../../scripts/assert-tracking-url.mjs",
    "prerender": "python3 ../../scripts/prerender.py",
    "sitemap": "python3 ../../scripts/generate-sitemap.py",
    "rss": "python3 ../../scripts/generate-rss.py",
    "assert-content": "python3 ../../scripts/assert-content-drift.py",
    "content": "python3 ../../scripts/generate-sitemap.py && python3 ../../scripts/generate-rss.py && python3 ../../scripts/assert-content-drift.py",
    "build:live": "npm run content && npm run build && npm run prerender",
    "dev": "vite",
    "preview": "vite preview"
  },
  "type": "module",
  "version": "0.1.0"
}