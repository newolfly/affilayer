# AffiLayer web — copy to .env (never commit a real .env)
# Supabase (optional). When BOTH are set, the app uses Supabase Auth + tables.
# When either is missing, the app runs in clearly-labeled DEMO MODE with fake data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Tracking service base URL (used to build /c/{affiliate_code}/{offer_id} links)
VITE_TRACKING_URL=http://localhost:3001
# NEVER put a Supabase service-role key in the browser.
